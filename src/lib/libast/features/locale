tst	- note{ canonical UTF-8 name }end run{
	set -o noglob
	ifs=$IFS
	str=
	sys=
	for i in $(PATH=${DEFPATH:-/bin:/usr/bin}:$PATH locale -a | grep -i '\.UTF[-8]*$')
	do	IFS=.
		set -- $i
		IFS=$ifs
		case $2 in
		UTF-8)	str=$2
			break
			;;
		esac
		sys=$2
	done
	case $str in
	'')	str=$sys ;;
	esac
	case $str in
	'')	echo "#define _locale_utf8_str	0" ;;
	*)	echo "#define _locale_utf8_str	\"$str\"" ;;
	esac
}end

test - note{ default native UTF-8 locale for LC_CTYPE }end run{
	loc=
	all=$(PATH=${DEFPATH:-/bin:/usr/bin}:$PATH locale -a | grep -i '\.UTF[-8]*$')
	if	test -n "$all"
	then	loc=$(echo "$all" | grep -i '^C\.')
		test -z "$loc" && loc=$(echo "$all" | grep -i '^en_US\.')
		test -z "$loc" && loc=$(echo "$all" | grep -i '^en_' | head -1)
		test -z "$loc" && loc=$(echo "$all" | sed -n -e '1p')
	fi
	if	test -n "$loc"
	then	echo "#define _locale_utf8_native_ctype	\"$loc\""
	else	echo "#define _locale_utf8_native_ctype	0"
	fi
}end
