			prev include/fcin.h
			prev include/defs.h
			prev FEATURE/options
		done

		make data/limits.c
			prev include/ulimit.h
			prev %{INCLUDE_AST}/ast.h
			prev FEATURE/options
		done

		make data/msg.c
			prev include/edit.h
			prev include/jobs.h
			prev include/builtins.h
			prev include/history.h
			prev include/timeout.h
			prev include/shlex.h
			prev include/io.h
			prev include/path.h
			prev include/defs.h
			prev %{INCLUDE_AST}/ast.h
			prev FEATURE/options
		done

		make data/testops.c
			prev include/test.h
			prev include/defs.h
			prev %{INCLUDE_AST}/ast.h
			prev FEATURE/options
		done

		make data/keywords.c
			prev include/shlex.h
			prev include/shell.h
			prev FEATURE/options
		done

		make data/options.c
			prev include/shtable.h
			prev include/name.h
			prev include/defs.h
			prev FEATURE/options
		done

		make data/signals.c
			prev include/jobs.h
			prev include/defs.h
			prev FEATURE/options
		done

		make data/aliases.c
			prev include/defs.h
			prev FEATURE/options
		done

		make data/variables.c
			prev include/builtins.h
			prev include/variables.h
			prev include/defs.h
			prev include/name.h
			prev include/shtable.h
			prev include/shell.h
			prev %{INCLUDE_AST}/ast.h
			prev FEATURE/options
		done

		make data/lexstates.c
			prev include/lexstates.h
			prev %{INCLUDE_AST}/ast.h
			prev FEATURE/options
		done

		make edit/emacs.c
			prev %{INCLUDE_AST}/ast_release.h
			prev include/terminal.h
			prev include/edit.h
			prev include/history.h
			prev include/io.h
			prev include/defs.h
			prev %{INCLUDE_AST}/ast.h
			prev FEATURE/options
		done

		make edit/vi.c
			prev include/lexstates.h
			prev FEATURE/time
			prev include/terminal.h
			prev include/edit.h
			prev include/history.h
			prev include/io.h
			prev %{INCLUDE_AST}/ast.h
			prev include/defs.h
			prev FEATURE/options
		done

		make edit/hexpand.c
			prev include/edit.h
			prev include/defs.h
			prev FEATURE/options
		done

		setv _libshell_c_sources_ %{^}
	done c_sources

	note *
	note * All C source files that include preprocessor checks
	note * for SHOPT_DYMAMIC must go in the virtual rule below.
	note *

	make c_sources_shopt_dynamic virtual
		make bltins/typeset.c
			prev %{INCLUDE_AST}/dlldefs.h
			prev include/variables.h
			prev include/builtins.h
			prev include/history.h
			prev include/name.h
			prev include/path.h
			prev %{INCLUDE_AST}/error.h
			prev include/defs.h
			prev FEATURE/options
		done

		make sh/path.c
			prev FEATURE/time
			prev %{INCLUDE_AST}/endian.h
			prev %{INCLUDE_AST}/dlldefs.h
			prev include/test.h
			prev include/history.h
			prev include/jobs.h
			prev include/io.h
			prev include/path.h
			prev include/variables.h
			prev include/nval.h
			prev %{INCLUDE_AST}/ls.h
			prev include/fcin.h
			prev include/defs.h
			prev FEATURE/options
		done

		make data/builtins.c
			prev %{INCLUDE_AST}/cmdlist.h
			prev FEATURE/poll
			prev FEATURE/cmds
			prev include/jobs.h
			prev include/builtins.h
			prev include/version.h
			prev include/name.h
			prev include/ulimit.h
			prev include/shtable.h
			prev include/defs.h
			prev FEATURE/options
		done

		setv _libshell_c_sources_dyn_ %{^}
	done c_sources_shopt_dynamic

	note *
	note * Set common compiler invocation arguments
	note *

	setv compile %{CC} %{mam_cc_FLAGS} %{CCFLAGS} %{mam_cc_NOSTRICTALIASING} %{DEBUG+-DDEBUG=%{DEBUG}} -DSH_DICT=%{SH_DICT} %{SH_CMDLIB_DIR+-DSH_CMDLIB_DIR=%{SH_CMDLIB_DIR}} -I. -Iinclude -I%{INCLUDE_AST} -D_API_ast=20100309 -c

	note *
	note * Build *_dyn.o object files for dynamic library
	note *

	loop SRC %{_libshell_c_sources_dyn_}
		make %{SRC@basename -- "$1" .c}_dyn.o dontcare
			prev %{SRC}
			exec - if dylink -Q; then %{compile} -DSHOPT_DYNAMIC=1 -o %{@} %{<}; fi
		done
	done
	setv _libshell_dyn_obj_files_ %{_libshell_c_sources_dyn_|sed 's>.*/>>; s>\.c$>_dyn.o>'}

	note *
	note * Build the library
	note *

	make libshell.a
		loop SRC %{_libshell_c_sources_}
			make %{SRC@basename -- "$1" .c}.o
				prev %{SRC}
				exec - %{compile} %{<}
			done
		done

		note * save for dylink
		setv _libshell_object_files_ %{^} strdata.o

		loop SRC %{_libshell_c_sources_dyn_}
			make %{SRC@basename -- "$1" .c}.o
				prev %{SRC}
				exec - %{compile} -DSHOPT_DYNAMIC=0 %{<}
			done
		done

		note * postpone dependency on the huge FEATURE/math test to this late
		note * stage, so that it can run in parallel for as long as possible
		make strdata.o
			make data/strdata.c
				prev FEATURE/math
				prev include/streval.h
				prev %{INCLUDE_AST}/ast_standards.h
				prev FEATURE/options
			done
			exec - %{compile} %{<}
		done

		note * include shell action for linking the library
		incl link_ar.mam
	done libshell.a

	note *
	note * Non-libshell object files
	note *

	loop OBJ pmain shcomp
		make %{OBJ}.o
			prev sh/%{OBJ}.c
			exec - %{compile} %{<}
		done
	done

	note *
	note * Pre-install public headers & dependency rules early (before 'bind -lshell')
	note *

	loop DIR bin include/ast lib/lib man/man1 man/man3 fun etc
		make %{INSTALLROOT}/%{DIR}
			exec - mkdir -p %{@}
		done
	done
	make %{INSTALLROOT}/lib/mam/shell
		loop HDR nval shell history
			make %{INCLUDE_AST}/%{HDR}.h
				prev include/%{HDR}.h
				exec - cp -f %{<} %{@}
			done
		done
		note * generate header dependency rules
		exec - mkdeps -lshell -last -ldll -lcmd %{^} > %{@}
		makp %{INSTALLROOT}/bin/mkdeps
		prev shell.req
	done %{INSTALLROOT}/lib/mam/shell

	note *
	note * Set the mam_libshell variable
	note *

	bind -lshell

	note *
	note * Link binaries
	note *

	shim - link_binary()
	shim - {
	shim -     %{CC} %{CCLDFLAGS} %{mam_cc_FLAGS} %{CCFLAGS} %{LDFLAGS} -o "$@" %{mam_libshell}
	shim - }

	make ksh
		bind -lshell
		prev pmain.o
		exec - link_binary %{@} %{<}
	done ksh

	make shcomp
		bind -lshell
		prev shcomp.o
		exec - link_binary %{@} %{<}
	done shcomp

	note *
	note * Dynamically linked version, if supported
	note *

	setv dyn_libshell %{INSTALLROOT}/dyn/lib/%{DYLIB_PRE}shell%{DYLIB_SUF}

	make %{dyn_libshell} dontcare
		prev shell.req
		loop OBJ %{_libshell_object_files_} %{_libshell_dyn_obj_files_}
			prev %{OBJ}
		done
		exec - export LDFLAGS='%{LDFLAGS} %{CCLDFLAGS} %{mam_cc_LD_NOASNEEDED}'
		exec - dylink -m shell -v %{DYLIB_VERSION} -p '%{DYLIB_PRE}' -s '%{DYLIB_SUF}' %{_libshell_object_files_} %{_libshell_dyn_obj_files_}
	done

	make %{INSTALLROOT}/dyn/bin/ksh dontcare
		prev ksh
		prev %{dyn_libshell}
		exec - export LDFLAGS='%{LDFLAGS} %{CCLDFLAGS} %{mam_cc_LD_NOASNEEDED} %{mam_cc_EXPORT_DYNAMIC}'
		exec - dylink -e ksh -l shell pmain.o
	done

	make %{INSTALLROOT}/dyn/bin/shcomp dontcare
		prev shcomp
		prev %{dyn_libshell}
		exec - export LDFLAGS='%{LDFLAGS} %{CCLDFLAGS} %{mam_cc_LD_NOASNEEDED} %{mam_cc_EXPORT_DYNAMIC}'
		exec - dylink -e shcomp -l shell shcomp.o
	done

	note *
	note * Pre-install the rest
	note *

	loop EXE ksh shcomp
		make %{INSTALLROOT}/bin/%{EXE}
			prev %{EXE}
			note * macOS throws code signature error if 'cp' overwrites Mach-O binary; must remove first
			exec - rm -f %{@} && cp %{<} %{@}
		done
	done
	make %{INSTALLROOT}/man/man1/sh.1
		makp sh.1
		exec - cp -f %{<} %{@}
	done
	make %{INSTALLROOT}/lib/libshell.a
		prev libshell.a
		exec - cp -f %{<} %{@}
	done
	loop MAN3PG shell nval
		make %{INSTALLROOT}/man/man3/%{MAN3PG}.3
			makp %{MAN3PG}.3
			exec - cp -f %{<} %{@}
		done
	done
	make %{INSTALLROOT}/lib/lib/shell
		prev shell.req
		exec - cp -f %{<} %{@}
	done
	loop FUN autocd cd dirs man mcd popd pushd
		make %{INSTALLROOT}/fun/%{FUN}
			makp fun/%{FUN}
			exec - cp -f %{<} %{@} && chmod ugo+x %{@}
		done
	done
	make %{INSTALLROOT}/etc/kshrc
		makp kshrc.sh
		exec - cp -f %{<} %{@}
	done
done install

note *
note * Run regression tests.
note *

make test virtual
	prev install
	make test.ksh virtual
		makp tests/shtests
		exec - : ---- Regression-testing "$SHELL" ----
		exec - cd "$PACKAGEROOT/src/cmd/ksh93/tests" && ./shtests
	done
done test
