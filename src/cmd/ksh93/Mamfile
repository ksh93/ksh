	note *
	note * Generate Git commit information
	note *
	make git.h force notrace
		note * Check that we are not only in a git repo, but in our own git repo
		exec -	if	top_level=$(git rev-parse --show-toplevel 2>/dev/null) &&
		exec -		test -n "$top_level" && test -f "$top_level/src/cmd/ksh93/Mamfile"
		exec -	then	git_commit=$(git rev-parse --short=8 HEAD 2>/dev/null)
		exec -	else	git_commit=
		exec -	fi
		exec -	case $?,$git_commit in
		exec -	0,[0-9a-z][0-9a-z][0-9a-z][0-9a-z][0-9a-z][0-9a-z][0-9a-z][0-9a-z])
		exec -		echo "/* generated by ksh93/Mamfile using $(git --version) */"
		note *		# Add /MOD to commit string if relevant files are modified
		exec -		git_wd_isclean
		exec -		test "$?" -eq 1 && git_commit=$git_commit/MOD
		exec -		echo "#define git_commit \"$git_commit\""
		exec -		echo "# current git commit: $git_commit" >&2  # for the log
		exec -		;;
		exec -	*)
		exec -		echo "/* generated by ksh93/Mamfile (we're not in the ksh git repo) */"
		exec -		echo "#undef git_commit"
		exec -		;;
		exec -	esac > git.h.new || exit
		exec -	if	cmp -s git.h.new git.h
		exec -	then	rm -f git.h.new
		exec -	else	mv -f git.h.new git.h
		exec -	fi
	done

